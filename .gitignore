# The repo root holds 81GB, of which 71GB is data/ containing patient images.
# Bulk directories are excluded wholesale, then binary/patient formats are
# excluded by extension everywhere else, so a stray image cannot be committed
# even from a directory that is otherwise tracked.
data/
tmp/
output/
Hulu-Med/
甲劈微循环hf_biomedclip/
sam_audit_preview/
seg_visual_check/
captures_app/
人工核对/
.transfer/
.verify/
.tmp_probe/
.codex_tmp_ppt_inspect/
server_code_audit/
github_nailfold_capillaroscopy/

# Binary, patient-facing, and bulky formats: never committed.
*.jpg
*.jpeg
*.png
*.tar.gz
*.zip
*.pptx
*.pdf
*.rtf
*.xlsx
*.html
*.pkl
*.npz
*.pt
*.pth
