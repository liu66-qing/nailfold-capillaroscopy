*.jsonl
*.joblib
*.onnx
*.bin
*.ckpt
*.h5
*.log

*.npy
*.parquet
*.docx

# ONNX external-data blobs and the chunked splits used to ship them.
# 4 x 354MB of siglip2 weights plus part.NN splits: regenerable, not source.
*.onnx.data
*.delta
artifacts/windows_model*/
**/*_chunks/
**/chunks/
*.part.[0-9][0-9]
*part.[0-9][0-9][0-9]

# Trained model binaries and per-fold dumps: regenerable, not source.
artifacts/geometry_*/
artifacts/video_*/
**/checkpoints/
**/*_locked/*.joblib
__pycache__/
*.pyc
.ipynb_checkpoints/

# Prediction dumps and per-frame tables: bulky and regenerable.
*_pred.jsonl
*.csv.bak

# Secrets. .env holds an API key; it must never enter git history.
.env
.env.*
*.pem
*.key
.netrc
secrets*
credential*
